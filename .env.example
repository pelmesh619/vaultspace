# PostgreSQL credentials (used by the postgres and api services).
# Change the password before running on a real machine.
POSTGRES_DB=vaultspace
POSTGRES_USER=vaultspace
POSTGRES_PASSWORD=change_me

# Private Docker registry (host:port) and image tag.
# Used by docker-compose.deploy.yml on the target machine.
# Replace the example IP with the machine where the registry runs.
REGISTRY_HOST=192.168.1.50:5000
IMAGE_TAG=0.2.0

# Host port for the frontend (nginx inside the container listens on 8080).
FRONTEND_PORT=8080
